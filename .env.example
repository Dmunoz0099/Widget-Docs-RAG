# ============================================================================
#  Widget Docs RAG  ·  Variables de entorno
#  Copia este archivo a ".env" y rellena los valores:  cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
#  BASE DE DATOS  (PostgreSQL de Supabase con pgvector)
# ---------------------------------------------------------------------------
# Cadena de conexion de Supabase. Panel > Project Settings > Database >
# Connection string > URI. Sustituye [YOUR-PASSWORD] (con los corchetes) por tu
# contrasena real e incluye el host completo (...pooler.supabase.com:5432/postgres).
# Si tu contrasena tiene "#", escribelo como "%23".
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
#  PROVEEDOR DE IA  (embeddings + generacion)
# ---------------------------------------------------------------------------
# Proveedor activo. Opciones: gemini | claude | openai
# Arquitectura desacoplada: cambiar de proveedor NO requiere tocar codigo.
AI_PROVIDER=gemini

# Dimension del vector de embeddings. DEBE coincidir con el modelo de embeddings.
#   - gemini  gemini-embedding-001      -> 768 / 1536 / 3072 (configurable; usamos 768)
#   - openai  text-embedding-3-small    -> 1536
#   - openai  text-embedding-3-large    -> 3072
# OJO: si cambias de dimension, hay que re-ingestar (la tabla se crea con esta dim).
EMBEDDING_DIM=768

# --- Gemini (proveedor por defecto) ---
# API key de Google AI Studio: https://aistudio.google.com/app/apikey
# NOTA: la capa gratuita de Gemini limita embeddings a ~100 requests/dia y algunos
# modelos de chat pueden tener cuota 0. Modelos verificados que funcionan en free:
#   chat: gemini-flash-latest  ·  embeddings: gemini-embedding-001
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Claude (opcional, para produccion) ---
# NOTA: Anthropic NO ofrece embeddings; si usas claude para generacion, deja
# AI_PROVIDER=claude pero define EMBEDDING_PROVIDER=gemini (u openai) para embed.
ANTHROPIC_API_KEY=
CLAUDE_CHAT_MODEL=claude-3-5-haiku-latest

# --- OpenAI (opcional) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Proveedor de embeddings independiente del de chat (opcional).
# Vacio = usa AI_PROVIDER tambien para embeddings.
EMBEDDING_PROVIDER=

# ---------------------------------------------------------------------------
#  PIPELINE DE INGESTA
# ---------------------------------------------------------------------------
# Lista de indices llms.txt separados por coma. Para agregar mas manuales,
# anade su URL aqui y vuelve a correr "pnpm ingest". No se toca codigo.
LLMS_INDEXES=https://docs.itam.app/dps-pos/llms.txt

# Delay (ms) entre descargas de paginas .md.
FETCH_DELAY_MS=300

# Chunking (por headings + tamano)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---------------------------------------------------------------------------
#  BACKEND / SERVIDOR
# ---------------------------------------------------------------------------
PORT=3000

# Cuantos chunks relevantes recuperar para armar el contexto del prompt.
RAG_TOP_N=5

# CORS: lista blanca de origenes separada por coma. NUNCA uses "*".
# Para probar en local, incluye http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://ims.itam.app,https://backoffice.itam.app

# Rate limiting por IP (endpoint publico)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
